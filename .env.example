COMPOSE_PROJECT_NAME=tippgame
APP_UID=1500
APP_GID=1500

# Django runtime
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=tipp_game.settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web


# Primary database
MARIADB_DATABASE=tipp_game
MARIADB_USER=tipp_game
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Django DB mapping
DB_NAME=tipp_game
DB_USER=tipp_game
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# Secondary wallabag database
WB_DATABASE=wallabag
WB_USER=wallabag
WB_PASSWORD=change-me

# Email
EMAIL_USE_TLS=true
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=change-me
ADMINS=Admin,admin@example.com
MAILER_LIST=Mailer,mailer@example.com

# Captcha and OTP
CAPTCHA_LETTER_ROTATION=
OTP_TOTP_ISSUER=tipp_game

# WhatsApp gateway
WA_SRV=wa-gateway
WA_PORT=9009
WA_ADMIN_NUMBER=491700000000

# Threema
TR_ID=*
TR_SECRET=change-me
TR_SK=private:change-me

# Optional one-shot cron export (used by tools/cron_create.py)
# The output file should be placed in a host path mounted into the job container.
CRON_TARGET_DIR=/app/cron_out
CRON_TARGET_FILE=tippgame
# Example command prefix for host cron entries to run tools via Docker:
# CRON_EXECUTION_PREFIX=docker compose --project-directory /srv/data/tipp_game run --rm jobs python
CRON_EXECUTION_PREFIX=